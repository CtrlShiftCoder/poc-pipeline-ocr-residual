# === Azure Blob Storage ===
# Cadena de conexión o SAS del contenedor con imágenes residuales
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=boletas-residuales
# Prefijo opcional dentro del contenedor (ej: residual/2026/)
AZURE_BLOB_PREFIX=

# === PostgreSQL ===
# URL SQLAlchemy, ej: postgresql+psycopg2://user:pass@host:5432/residual_ocr
DATABASE_URL=postgresql+psycopg2://residual:residual@localhost:5432/residual_ocr

# === OCR ===
# Workers concurrentes para Stage1 (bajo en VM pequeña)
OCR_WORKERS=2
# Reintentos con backoff exponencial ante fallos de OCR/Blob
OCR_MAX_RETRIES=3
# Idioma PaddleOCR (chileno: español)
OCR_LANG=es
# Usar GPU (false en VM CPU típica Azure)
OCR_USE_GPU=false

# === Matching Stage2 ===
# Umbral RapidFuzz (0-100) para match fuzzy
MATCH_FUZZY_THRESHOLD=85
# Ruta CSV maestro (boletas ya conciliadas / catálogo)
MASTER_CSV_PATH=samples/master.csv
# Lista residual (nombres de archivo / ids a procesar)
RESIDUAL_LIST_CSV=samples/residual_list.csv

# === Email (opcional) ===
EMAIL_ON_MATCH=false
EMAIL_DIGEST_SIZE=100
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# === App ===
LOG_LEVEL=INFO
